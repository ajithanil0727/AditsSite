# Copy to .env and adjust.

# --- Database ---------------------------------------------------------------
# Docker Compose (docker compose up -d):
DATABASE_URL="postgresql://mgmt:mgmt@localhost:5432/mgmt"
# Without Docker you can use Prisma's local Postgres instead:
#   npx prisma dev -d --name mgmt   then copy the TCP url from `npx prisma dev ls`
# SHADOW_DATABASE_URL is only needed for `prisma migrate dev` when the DB user cannot create databases.
# SHADOW_DATABASE_URL=""
# Connections per app process (default 10). Use 2-3 with `prisma dev`.
# DATABASE_POOL_MAX="10"

# --- Auth -------------------------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or any 32+ char random string)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-of-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"
# Encrypts device unlock codes (32+ random chars). Never change it once data exists: old codes become unreadable.
DATA_ENCRYPTION_KEY="change-me-to-another-long-random-string-32+"

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- File storage -------------------------------------------------------------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3 / Cloudflare R2 (production)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email (Mailpit in dev) ---------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Institute <no-reply@example.com>"

# --- Cron ---------------------------------------------------------------------
CRON_SECRET="change-me"

# --- Seed ---------------------------------------------------------------------
# Password given to all seeded demo users (dev only)
SEED_DEFAULT_PASSWORD="Demo@12345"
