// =============================================================================
// Phase 0 DRAFT schema. Design only, no migrations yet.
// Target: Prisma 7.x (stable) + PostgreSQL. The connection URL lives in prisma.config.ts.
//
// Conventions
// - ids: cuid strings
// - money: Decimal(12,2) in INR, percentages: Decimal(5,2), stock qty: Decimal(12,3)
// - `organizationId` is on every main table (SaaS-ready). Only core tables have an FK
//   to Organization, so the model doesn't need 100 back-relations. The rest store it as a plain indexed column.
// - `deletedAt` = soft delete. Queries filter it out by default (via a Prisma client extension).
// - "Who" fields that drive scope (engineer, trainer, counsellor) point to User.
//   Employee is the HR record and links 1:1 to a User when that person can log in.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

