# Test deployment (Vercel + Neon + Cloudflare R2). Copy to .env.vercel (never committed) and fill in.
# Used only on your computer to create the tables and load the data into the Neon database.
# The SAME values go into Vercel → Project → Settings → Environment Variables.

# Neon → your project → Connection string → "Direct connection" (not "Pooled"), with ?sslmode=require
DATABASE_URL=""
DATABASE_POOL_MAX="3"

# Long random strings (32+ characters). Generate: open https://www.random.org/strings or ask Claude.
BETTER_AUTH_SECRET=""
DATA_ENCRYPTION_KEY=""
CRON_SECRET=""

# The address Vercel gives you, e.g. https://adits-test.vercel.app (fill after the first deploy)
BETTER_AUTH_URL=""
APP_URL=""

# File storage (S3-compatible). Either:
#  - Supabase Storage (no card): Project Settings → Storage → S3 Connection.
#      S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"   S3_REGION="ap-south-1" (as shown there)
#  - Cloudflare R2 (needs a card on file): S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   S3_REGION="auto"
STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="adits-test"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Password for all demo logins on the TEST site (not Demo@12345: the site is public). Local only, not needed in Vercel.
SEED_DEFAULT_PASSWORD=""
